---
/** The experience Section: the episode guide, newest Episode first. */
import { site } from '../lib/content.ts';
import Episode from './Episode.astro';
import SectionHeading from './SectionHeading.astro';

const section = site.sections[1];
---

<section id={section.id} class="section experience">
  <div class="exp-head">
    <SectionHeading section={section} />
  </div>
  <div class="eps">
    {site.episodes.map((episode) => <Episode episode={episode} />)}
  </div>
</section>

<style>
  @layer components {
    .experience {
      display: flex;
      flex-direction: column;
      padding-top: 200px;
    }
    .exp-head {
      margin-bottom: 56px;
    }
    .eps {
      display: flex;
      flex-direction: column;
    }
  }
</style>
