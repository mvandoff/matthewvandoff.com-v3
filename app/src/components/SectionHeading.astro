---
/**
 * Section heading: "02 / 04", a rule drawn in the Accent, then the Section name
 * and its Japanese label. The title block hosts the Lock-on (rendered hidden;
 * scripts/motion/scroll.ts shows it). The rule draws in once the Section is
 * revealed (.rv.in); without JS, or with reduced motion, it is simply drawn.
 */
import { site, type SectionCopy } from '../lib/content.ts';

interface Props {
  section: SectionCopy;
}

const { section } = Astro.props;
---

<div class="sh">
  <span class="sh-n"><span class="acc">{section.number}</span><span>/ {site.sectionTotal}</span></span>
  <span class="sh-r" aria-hidden="true"></span>
  <span class="sh-t">
    <span class="lock" data-lock={section.id} aria-hidden="true" hidden></span>
    <span class="locktag" data-lock={section.id} aria-hidden="true" hidden>{site.lockOn}{section.id}</span>
    <span>{section.label}{section.headingSuffix && <span class="sh-x">{section.headingSuffix}</span>}</span>
    <span class="sh-jp" lang="ja">{section.jp}</span>
  </span>
</div>

<style>
  @layer components {
    .sh {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 11px;
      line-height: 1;
      letter-spacing: 0.1em;
      color: var(--dim);
      white-space: nowrap;
    }
    .sh-n {
      display: inline-flex;
      align-items: center;
      gap: 14px;
    }
    .sh-r {
      flex: 1 1 auto;
      min-width: 24px;
      height: 1px;
      background: var(--rule);
      position: relative;
      overflow: hidden;
    }
    .sh-r::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--accent);
      opacity: 0.55;
      transform-origin: left;
    }
    /* Reveal on scroll (board 208-209): undrawn until the Section is seen. */
    :global(.rv) .sh-r::after {
      transform: scaleX(0);
      transition: transform 1.4s var(--ease-snap) 0.25s;
    }
    :global(.rv.in) .sh-r::after {
      transform: scaleX(1);
    }
    .sh-t {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 12px;
    }
    .sh-jp {
      font-family: var(--font-jp);
      font-size: 16px;
      letter-spacing: 0;
      color: var(--accent);
    }
  }
</style>
