---
/**
 * A narrow navigation Cel in the Strip: a plain anchor link to a Section, with
 * its number and a vertical label (English plus Japanese). On hover or keyboard
 * focus the .hov dotted Accent wash wipes down, the border and the label turn
 * Accent. With JS, a click smooth-scrolls and locks on
 * (scripts/motion/scroll.ts).
 */
import type { SectionCopy } from '../lib/content.ts';

interface Props {
  section: SectionCopy;
  /** Where the link goes: the Section on this page by default; the 404 page links to `/#<id>`. */
  href?: string;
}

const { section, href = `#${section.id}` } = Astro.props;
---

<a class="cel nav" href={href}>
  <span class="hov" aria-hidden="true"></span>
  <span class="cel-n">{section.number}</span>
  <span class="vlabel">{section.label} <span class="vlabel-jp" lang="ja">{section.jp}</span></span>
</a>

<style>
  @layer components {
    .nav:hover,
    .nav:focus-visible {
      border-color: var(--accent);
      color: var(--ink);
    }
    .nav:hover .vlabel,
    .nav:focus-visible .vlabel {
      color: var(--accent);
    }
    .hov {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle, color-mix(in srgb, var(--accent) 60%, transparent) 1px, transparent 1.6px) 0
        0 / 7px 7px;
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.35) 45%, transparent 80%);
      mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.35) 45%, transparent 80%);
      clip-path: inset(0 0 100% 0);
      transition: clip-path 0.3s var(--ease-out);
      pointer-events: none;
    }
    .nav:hover .hov,
    .nav:focus-visible .hov {
      clip-path: inset(0 0 0 0);
    }
    .cel-n {
      position: relative;
      font-size: 11px;
      color: var(--dim);
      letter-spacing: 0.08em;
      white-space: nowrap;
    }
    .vlabel {
      position: relative;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      white-space: nowrap;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 28px;
      letter-spacing: -0.01em;
      transition: color 0.1s;
    }
    .vlabel-jp {
      margin-inline-start: 10px;
      font-family: var(--font-jp);
      font-weight: 400;
      font-size: 14px;
      color: var(--dim);
      letter-spacing: 0;
    }
  }
</style>
