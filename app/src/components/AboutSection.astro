---
/** The about Section: heading with its last clause in the Accent, then its paragraphs, which may hold links. */
import { site } from '../lib/content.ts';
import SectionHeading from './SectionHeading.astro';

const section = site.sections[0];
const { heading, paragraphs } = site.about;
---

<section id={section.id} class="section about">
  <SectionHeading section={section} />
  <div class="ab-body">
    <h2 class="ab">{heading.lead} <span class="acc">{heading.accent}</span></h2>
    <div class="ab-cols">
      {
        paragraphs.map((paragraph) => (
          <p class="ab-p">
            {paragraph.map((run) =>
              typeof run === 'string' ? (
                run
              ) : (
                <a class="ab-a" href={run.href} target="_blank" rel="noopener" aria-describedby="new-tab">
                  {run.label}
                </a>
              ),
            )}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  @layer components {
    .about {
      display: flex;
      flex-direction: column;
      gap: 64px;
      padding-top: 200px;
    }
    .ab-body {
      width: 100%;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 56px;
    }
    .ab {
      margin: 0;
      font-family: var(--font-head);
      font-weight: 600;
      font-size: clamp(26px, 3.4vw, 48px);
      line-height: 1.08;
      letter-spacing: -0.025em;
      text-wrap: balance;
    }
    .ab-cols {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
      gap: 24px 48px;
      padding-top: 32px;
      border-top: 1px solid var(--rule);
    }
    .ab-p {
      max-width: 72ch; /* a lone paragraph would otherwise run the full width */
      margin: 0;
      color: var(--ink-3);
      text-wrap: pretty;
    }
    .ab-a {
      color: var(--ink);
      text-decoration: none;
      transition: color 0.15s;
    }
    .ab-a:hover,
    .ab-a:focus-visible {
      color: var(--accent);
    }
  }
</style>
